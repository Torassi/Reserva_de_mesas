                android:textSize="14sp"/>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="350dp"
            android:layout_height="100dp"
            android:layout_marginLeft="20dp">

            <EditText
                android:id="@+id/NmrMesa"
                android:layout_width="150dp"
                android:layout_height="48dp"
                android:hint="Número Mesa">
            </EditText>

            <Button
                android:id="@+id/LiberarMesa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Liberar Mesa"></Button>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <Button
            android:id="@+id/SalvarOperacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvar Operação">
        </Button>

        <Button
            android:id="@+id/ReservarTodas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reservar_todas"/>

        <Button
            android:id="@+id/btnConfiguracoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/configuracoes" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/logout" />

    </LinearLayout>

</LinearLayout>
